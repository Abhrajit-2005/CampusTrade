// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ItemStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  REMOVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  CHAT
  ORDER
  ITEM
  SYSTEM
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  FAKE_ITEM
  SCAM
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model College {
  id          String   @id @default(uuid())
  name        String
  domain      String   @unique
  city        String
  state       String
  country     String
  isVerified  Boolean  @default(true)

  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([name])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  icon        String?

  items       Item[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model User {
  id                  String      @id @default(uuid())

  name                String
  email               String      @unique
  password            String

  phone               String?
  bio                 String?
  profileImage        String?

  role                Role        @default(USER)
  status              UserStatus  @default(PENDING_VERIFICATION)

  isEmailVerified     Boolean     @default(false)

  averageRating       Float       @default(0)
  totalReviews        Int         @default(0)

  collegeId           String
  college             College     @relation(fields: [collegeId], references: [id])

  items               Item[]

  wishlist            Wishlist[]

  purchases           Order[]     @relation("BuyerOrders")
  sales               Order[]     @relation("SellerOrders")

  sentMessages        Message[]

  conversationsBought Conversation[] @relation("BuyerConversation")
  conversationsSold   Conversation[] @relation("SellerConversation")

  reviewsGiven        Review[]    @relation("Reviewer")
  reviewsReceived     Review[]    @relation("Reviewee")

  notifications       Notification[]

  reports             Report[]

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  deletedAt           DateTime?

  @@index([collegeId])
}

model Item {
  id              String          @id @default(uuid())

  title           String
  description     String

  price           Int

  isNegotiable    Boolean         @default(false)

  condition       ItemCondition

  status          ItemStatus      @default(DRAFT)

  pickupLocation  String

  views           Int             @default(0)
  wishlistCount   Int             @default(0)

  sellerId        String
  seller          User            @relation(fields: [sellerId], references: [id])

  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id])

  images          ItemImage[]

  wishlist        Wishlist[]

  orders          Order[]

  conversations   Conversation[]

  reports         Report[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([price])
  @@index([createdAt])
}

model ItemImage {
  id            String   @id @default(uuid())

  imageUrl      String

  displayOrder  Int

  isPrimary     Boolean  @default(false)

  itemId        String
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([itemId])
}

model Wishlist {
  id          String   @id @default(uuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  itemId      String
  item        Item     @relation(fields: [itemId], references: [id])

  createdAt   DateTime @default(now())

  @@unique([userId, itemId])

  @@index([userId])

  @@index([itemId])
}

model Order {
  id            String        @id @default(uuid())

  price         Int

  itemTitle     String

  status        OrderStatus   @default(PENDING)

  buyerId       String
  buyer         User          @relation("BuyerOrders", fields: [buyerId], references: [id])

  sellerId      String
  seller        User          @relation("SellerOrders", fields: [sellerId], references: [id])

  itemId        String
  item          Item          @relation(fields: [itemId], references: [id])

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@index([buyerId])

  @@index([sellerId])

  @@index([itemId])
}

model Review {
  id              String      @id @default(uuid())

  rating          Int

  comment         String?

  response        String?

  itemId          String
  item            Item            @relation(fields: [itemId], references: [id])

  orderId         String          @unique
  order           Order           @relation(fields: [orderId], references: [id])

  reviewerId      String
  reviewer        User        @relation("Reviewer", fields: [reviewerId], references: [id])

  revieweeId      String
  reviewee        User        @relation("Reviewee", fields: [revieweeId], references: [id])

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
}